NODE_ENV=development
PORT=5000

# MongoDB connection
# Use MONGODB_URI or MONGO_URI. MONGODB_DB is optional when the URI includes a database name.
MONGODB_URI=mongodb://127.0.0.1:27017/maple_crm
MONGODB_DB=maple_crm
MONGO_POOL_MAX=30
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# JWT (REQUIRED in production)
JWT_SECRET=replace-with
JWT_EXPIRES_IN=1d

# Password hashing
BCRYPT_ROUNDS=10

# Client / CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=26214400

# Email (optional — leave blank to skip sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@maple-crm.local
